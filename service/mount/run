#!/system/bin/sh
# sing-box runsv service (main service) -- "mount" variant.
# The binary is shipped in the module and mounted at /system/bin/sing-box, so
# it stays readable/executable even after chpst drops privileges to a normal
# user. sing-box needs CAP_NET_ADMIN for the tunnel, so the default keeps uid 0.
# Settings live in ./conf next to this script.
# Installed to /data/adb/runsvdir/service/sing-box/run on a fresh install.
# Edit run / conf freely: they are only written again when the installer's
# "update scripts" option is used.
exec 2>&1

cd "$(dirname "$0")" || exit 1

. ./conf

# chpst is a runit applet; runsvdir-magisk installs it into /system/bin.
if [ -x /system/bin/chpst ]; then
    CHPST=/system/bin/chpst
else
    CHPST=chpst
fi

if [ "$WAIT_DECRYPT" != "0" ]; then
    echo "sing-box(runsv): waiting for user storage decryption..."
    if [ "$(getprop sys.user.0.ce_available)" != "true" ]; then
        echo "sing-box(runsv): storage not decrypted yet, retrying"
        sleep 10
        exit 1
    fi
    echo "sing-box(runsv): storage ready"
fi

exec "$CHPST" -u "$RUN_AS" sing-box $SINGBOX_ARGS run
